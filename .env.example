# Qu Lite relay settings for docker compose - copy to .env and adjust.
# Every value is optional; an empty value means "no limit" / "off".

# Swarm (docker-stack.yml): the domain caddy-docker-proxy serves, and the image to run.
QU_DOMAIN=relay.example.org
QU_IMAGE=ghcr.io/reactivityjs/qu-lite:main

# Compose only - where the port is published: 127.0.0.1 = only this machine (behind a reverse proxy),
# 0.0.0.0 = directly reachable (e.g. for a test in the local network).
QU_BIND=127.0.0.1
QU_PUBLISH_PORT=8787

# Most spaces this relay accepts. Anyone can create spaces - set it for a public relay.
QU_MAX_SPACES=10000
# Per-space quota (every group and every inbox): envelopes and bytes.
QU_QUOTA_RECORDS=200000
QU_QUOTA_BYTES=1073741824
# Largest single envelope in bytes.
QU_MAX_ENVELOPE=262144
# Inbound frames per second and connection (0 = no rate limit).
QU_RATE=200
# Only these space ids (comma-separated); empty = any space.
QU_ALLOW=

# The relay serves its start page (/), the demo and the browser bundle (/dist/...) - browser apps on this
# address use this relay by default. Empty = only the API (/ws, /sse, /q/, /id/, /push/, /healthz).
QU_STATIC=/app/web
# Your own app at / (a folder inside the container, e.g. /srv/app - see docs/INSTALL.md "Your app at /").
# The relay's start page then answers at /qu.html; /dist/... and /demo.html stay. QU_SPA=1: unknown paths
# without a file extension get the app's index.html (client-side routing).
QU_APP=
QU_SPA=
# Web Push for closed apps: a contact address for the push services (mailto: or https:). Empty = off.
QU_PUSH=

# Enables /stats (JSON) and /metrics (Prometheus) for requests with
# "Authorization: Bearer <token>". Generate one: openssl rand -hex 24
QU_STATS_TOKEN=
