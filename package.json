{
  "name": "@qu/lite",
  "version": "0.1.0",
  "description": "Qu Lite: a small, offline-first, end-to-end encrypted sync core - sealed records verifiable by any peer, group encryption with epochs, Negentropy set reconciliation with partial sync, durable outbox, deletion and compaction, presence/receipts, pluggable storage (memory, IndexedDB, SQLite) and transports (WebSocket, HTTPS+SSE, WebRTC), and a key-less mirror/relay built from the same peer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReactivityJS/Qu-lite.git"
  },
  "homepage": "https://github.com/ReactivityJS/Qu-lite#readme",
  "bugs": {
    "url": "https://github.com/ReactivityJS/Qu-lite/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./src/node.js"
    },
    "./sqlite": {
      "types": "./types/drivers/sqlite.d.ts",
      "default": "./src/drivers/sqlite.js"
    },
    "./ws-server": {
      "types": "./types/net/ws-server.d.ts",
      "default": "./src/net/ws-server.js"
    },
    "./devtools": {
      "types": "./types/devtools.d.ts",
      "default": "./src/devtools.js"
    }
  },
  "bin": {
    "qu-lite-mirror": "./bin/mirror.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/",
    "types"
  ],
  "scripts": {
    "test": "node --test --test-timeout=240000 test/*.test.js",
    "test:unit": "node --test --test-timeout=240000 --test-skip-pattern=browsers test/*.test.js",
    "test:browser": "node --test --test-timeout=240000 test/demo.e2e.test.js",
    "build:web": "node web/build.mjs",
    "mirror": "node --no-warnings bin/mirror.mjs",
    "backup": "node --no-warnings bin/backup.mjs",
    "demo": "node web/build.mjs && node --no-warnings bin/mirror.mjs --static web --db ./lite-demo.sqlite",
    "types": "tsc -p tsconfig.types.json && node -e \"require('node:fs').copyFileSync('src/qu-types.d.ts','types/qu-types.d.ts')\" && tsc --noEmit -p test/types/tsconfig.json",
    "prepack": "npm run types"
  },
  "keywords": [
    "offline-first",
    "sync",
    "e2ee",
    "negentropy",
    "local-first",
    "crdt",
    "relay"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "types": "./types/index.d.ts"
}
