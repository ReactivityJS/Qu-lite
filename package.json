{
  "name": "@qu/lite",
  "version": "0.1.0",
  "description": "Qu Lite: a small, offline-first, end-to-end encrypted sync core - sealed records verifiable by any peer, group encryption with epochs, Negentropy set reconciliation with partial sync, durable outbox, deletion and compaction, presence/receipts, pluggable storage (memory, IndexedDB, SQLite) and transports (WebSocket, HTTPS+SSE, WebRTC), and a key-less mirror/relay built from the same peer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReactivityJS/Qu-lite.git"
  },
  "homepage": "https://github.com/ReactivityJS/Qu-lite#readme",
  "bugs": {
    "url": "https://github.com/ReactivityJS/Qu-lite/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./sqlite": "./src/drivers/sqlite.js",
    "./ws-server": "./src/net/ws-server.js"
  },
  "bin": {
    "qu-lite-mirror": "./bin/mirror.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "test": "node --test --test-timeout=240000 test/*.test.js",
    "test:unit": "node --test --test-timeout=240000 --test-skip-pattern=browsers test/*.test.js",
    "demo:build": "node demo/build.mjs",
    "mirror": "node --no-warnings bin/mirror.mjs",
    "demo": "node demo/build.mjs && node --no-warnings bin/mirror.mjs --static demo --db ./lite-demo.sqlite"
  },
  "keywords": [
    "offline-first",
    "sync",
    "e2ee",
    "negentropy",
    "local-first",
    "crdt",
    "relay"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  }
}
